# syntax=docker/dockerfile:1.7
# The api image. Build context is the repo root:
#   docker build -f infra/docker/Dockerfile.api .
# ---------- builder ----------
FROM node:20-alpine AS builder
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# Workspace manifests + lockfile first, so the install layer caches across source edits.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY packages/core/package.json packages/core/package.json
RUN pnpm install --filter @autotest/api... --frozen-lockfile --prod=false

COPY apps/api apps/api
COPY packages/core packages/core

# ---------- runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /repo

ARG GIT_SHA=local
ENV GIT_SHA=$GIT_SHA
ENV NODE_ENV=production
ENV PORT=8080

COPY --from=builder /repo /repo
WORKDIR /repo/apps/api
USER node

EXPOSE 8080
# The same as `pnpm start`, without needing pnpm in the runtime image.
CMD ["node", "--import", "tsx/esm", "src/server.ts"]
